# ShipSafe environment configuration.
#
# Leave the Supabase variables unset to run in demo mode: a seeded demo
# user, repository, and PR review, with no external services required.
# See docs/ARCHITECTURE.md § Environment & Demo Mode.

# --- Supabase (optional — enables real auth + persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode ---
# Used to sign the demo-session cookie. Any random string is fine for
# local development; set a real secret in any shared/demo deployment.
DEMO_SESSION_SECRET=shipsafe-demo-secret-dev-only
