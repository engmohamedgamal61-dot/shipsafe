# ShipSafe environment configuration.
#
# Leave the Supabase variables unset to run in demo mode: a seeded demo
# user, repository, and PR review, with no external services required.
# See docs/ARCHITECTURE.md § Environment & Demo Mode.

# --- Supabase (optional — enables real auth + persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App secret ---
# Signs the demo-session cookie and the short-lived GitHub-install "state"
# token. Any random string is fine for local development; set a real
# secret in any shared/production deployment.
APP_SECRET=shipsafe-app-secret-dev-only

# --- GitHub App (optional — enables real repo/PR ingestion) ---
# Requires Supabase to also be configured. Register your own GitHub App
# and set all four of these together — see docs/GITHUB_INTEGRATION.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- AI provider (optional — defaults to the deterministic mock reviewer) ---
# Set AI_PROVIDER=anthropic and your own Anthropic API key to replace the
# mock/demo heuristic reviewers with real Claude-backed ones for real
# GitHub PRs. Bring your own key — there is no "ShipSafe" account.
# See docs/ARCHITECTURE.md § AI Provider.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Cost/usage ceilings for the AI provider — safe defaults, override only
# if you need to.
AI_MAX_TOKENS_PER_REVIEWER=4096
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONCURRENT_REVIEWERS=3
